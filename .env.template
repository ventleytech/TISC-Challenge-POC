# VoltPulse — copy to .env and fill locally. Never commit real .env.
# Compose project: voltpulse (see infra/compose/docker-compose.yml)

# --- Bus / topics (vp.*) — Apache Kafka KRaft as pulse-bus (profiles stream + data) ---
# In-compose clients: pulse-bus:9092. Host CLI: localhost:${PULSE_KAFKA_HOST_PORT} (PLAINTEXT_HOST).
PULSE_KAFKA_BOOTSTRAP=pulse-bus:9092
PULSE_KAFKA_PORT=9092
PULSE_KAFKA_HOST_PORT=9094
# Fixed local-dev cluster id (kafka-storage format). Change only for a fresh volume.
PULSE_KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
PULSE_KAFKA_NODE_ID=1
# pulse-api Kafka consumer (P0-T330): off by default; HTTP ingest still works.
PULSE_KAFKA_CONSUMER_ENABLED=false
# PULSE_KAFKA_GROUP_ID=pulse-api
# PULSE_KAFKA_DEFAULT_UTILITY_ID=
# Dead-letter for skipped ingest messages (P0-T391): off by default. Topic is created by infra/kafka/create-topics.sh.
PULSE_KAFKA_DLQ_ENABLED=false
PULSE_KAFKA_DLQ_TOPIC=vp.dlq.v1
# PULSE_KAFKA_DLQ_FILE=/data/bus/vp.dlq.v1.jsonl   # set -> append JSONL instead of producing to Kafka
PULSE_TOPIC_PARTITIONS=1
PULSE_TOPIC_REPLICATION=1
PULSE_DETECT_TOPIC=vp.detect.v1
PULSE_FINDINGS_TOPIC=vp.findings.v1
PULSE_ALERTS_TOPIC=vp.alerts.v1
PULSE_LABELS_TOPIC=vp.labels.v1
PULSE_MODELS_TOPIC=vp.models.v1

# --- pulse-train (T396) ---
PULSE_TRAIN_PORT=3020
PULSE_TRAIN_HOST=0.0.0.0
PULSE_TRAIN_DATA_DIR_CONTAINER=/data/train
PULSE_TRAIN_RELOAD_MODE=log
PULSE_TRAIN_RELOAD_URL=http://127.0.0.1:3015/internal/reload
PULSE_TRAIN_JOB_AUTO_ADVANCE=true

# --- Media gateway ---
PULSE_GATEWAY_RTSP_PORT=8554
# pulse-gateway live-pull stub (P0-T380). Sink off by default; file|kafka publishes synthetic vp.detect.v1.
PULSE_GATEWAY_PORT=3020
# PULSE_GATEWAY_PULL_URLS=rtsp://127.0.0.1:8554/live/feeder-demo
PULSE_GATEWAY_DETECT_SINK=off
# PULSE_GATEWAY_DETECT_FILE=./data/bus/vp.detect.v1.jsonl  (host dev; compose uses PULSE_GATEWAY_DETECT_FILE_CONTAINER, default /data/bus/...)
# kafka mode also needs KAFKA_BROKERS (host: localhost:${PULSE_KAFKA_HOST_PORT}); topic = PULSE_DETECT_TOPIC
# PULSE_GATEWAY_KAFKA_CLIENT_ID=pulse-gateway

# --- Sense plane: grid-perception file ingest (P0-T384) ---
# Images dropped in /data/inbox -> one vp.detect.v1 JSON line each on /data/bus/vp.detect.v1.jsonl (volume pulse_bus_files).
# Default detectors = honest sag/thermal fallbacks (CPU, no weights). Gate0 weights need ultralytics (host venv / CUDA image).
# GP_INBOX_DIR_CONTAINER=/data/inbox
# GP_DETECT_FILE_CONTAINER=/data/bus/vp.detect.v1.jsonl
# GP_DETECTORS=sag,thermal_hotspot
# GP_POLL_MS=1000
# GP_MODELS_HOST_DIR=../../local-notes/models-experiments   (mounted ro at /models; relative to infra/compose)
# GP_WEIGHTS_CORROSION_CONTAINER=/models/corrosion/weights/Basic_YOLO11_v1.pt
# GP_WEIGHTS_CRACK_CONTAINER=/models/crack-damage/weights/vpmbgi-yolo11n-best.pt
# GP_WEIGHTS_VEGETATION_CONTAINER=/models/vegetation/weights/pl_yolov8s.pt

# --- Data plane ---
PULSE_API_PORT=3000
PULSE_API_BASE_URL=http://pulse-api:3000
PULSE_WEB_PORT=5173
PULSE_NOTIFY_ADAPTER=log
# pulse-notify sinks (P0-T360): adapter log | webhook | file. File sink in compose: PULSE_NOTIFY_FILE_PATH_CONTAINER=/data/notify/alerts.jsonl
PULSE_NOTIFY_PORT=3010
# PULSE_NOTIFY_WEBHOOK_URL=http://host:port/hook
# PULSE_NOTIFY_FILE_PATH_CONTAINER=/data/notify/alerts.jsonl
# pulse-notify Kafka consumer (P0-T365): off by default; POST /internal/consume still works.
# Needs flag AND KAFKA_BROKERS (host CLI: localhost:${PULSE_KAFKA_HOST_PORT}; in-compose: pulse-bus:9092).
PULSE_NOTIFY_KAFKA_ENABLED=false
# KAFKA_BROKERS=pulse-bus:9092
# PULSE_NOTIFY_KAFKA_GROUP_ID=pulse-notify
# PULSE_NOTIFY_KAFKA_CLIENT_ID=pulse-notify
# PULSE_NOTIFY_KAFKA_FROM_BEGINNING=false
# Browser-facing API base baked into pulse-web image at build (empty → mock client).
# Auth stub key is a local placeholder; rebuild pulse-web after changing.
# pulse-web bake args — live-by-default (T400); empty MOCK
PULSE_WEB_API_URL=http://127.0.0.1:3000/api/v1
PULSE_WEB_API_KEY=dev-operator

# --- Service health ports (T340 stub images) ---
GRID_RULES_HEALTH_PORT=8080
# grid-rules loop (P0-T382). Compose defaults: tail /data/bus/vp.detect.v1.jsonl, write findings/alerts jsonl to /data/bus.
# Kafka in/out are off by default; each needs its flag AND KAFKA_BROKERS (compose sets it from PULSE_KAFKA_BOOTSTRAP).
# GRID_RULES_DETECT_FILE=/data/bus/vp.detect.v1.jsonl
# GRID_RULES_OUT_DIR=/data/bus
# GRID_RULES_ASSETS_FILE=fixtures/assets.json
# GRID_RULES_POLL_MS=1000
GRID_RULES_KAFKA_CONSUMER_ENABLED=false
# GRID_RULES_KAFKA_GROUP_ID=grid-rules
# GRID_RULES_KAFKA_FROM_BEGINNING=false
GRID_RULES_KAFKA_PRODUCER_ENABLED=false
# grid-rules -> pulse-api HTTP sink (T393). Unset = off. In compose: http://pulse-api:${PULSE_API_PORT}
# GRID_RULES_API_BASE_URL=http://pulse-api:3000
# GRID_RULES_API_KEY=dev-operator-key
# GRID_RULES_API_TIMEOUT_MS=5000
GP_HEALTH_PORT=8081

# C10 auth stub (S5 Energy roles). Local placeholders only — rotate for shared envs.
# Format: key:role:utility_id;...  Empty utility_id only for platform_admin.
PULSE_AUTH_ENABLED=true
PULSE_AUTH_STUB_KEYS=dev-platform:platform_admin:;dev-utility:utility_admin:00000000-0000-4000-8000-000000000001;dev-supervisor:energy_supervisor:00000000-0000-4000-8000-000000000001;dev-operator:energy_operator:00000000-0000-4000-8000-000000000001;dev-viewer:viewer:00000000-0000-4000-8000-000000000001


# Postgres (Compose service pulse-postgres, profile data). Placeholders only.
PULSE_PG_USER=voltpulse
PULSE_PG_PASSWORD=change-me-local-only
PULSE_PG_DB=voltpulse
PULSE_PG_PORT=5432
# In-compose clients: host pulse-postgres. Host nest/migrate: 127.0.0.1:${PULSE_PG_PORT}.
PULSE_DATABASE_URL=postgres://voltpulse:change-me-local-only@pulse-postgres:5432/voltpulse
# Example host override:
# PULSE_DATABASE_URL=postgres://voltpulse:change-me-local-only@127.0.0.1:5432/voltpulse

# --- Object store (pulse-store / MinIO) ---
# Compose profile `store` runs MinIO as service `pulse-store` (API :9000, console :9001).
# apps/pulse-store client: set PULSE_STORE_BACKEND=minio and point ENDPOINT at that host.
#   In-compose / same Docker network: http://pulse-store:9000
#   Host process with published ports: http://127.0.0.1:9000
PULSE_STORE_BACKEND=fs
PULSE_STORE_ENDPOINT=http://pulse-store:9000
PULSE_STORE_BUCKET=voltpulse-evidence
# Comma-separated buckets created by pulse-store-buckets init (must include PULSE_STORE_BUCKET)
PULSE_STORE_BUCKETS=voltpulse-evidence,voltpulse-models
PULSE_STORE_API_PORT=9000
PULSE_STORE_CONSOLE_PORT=9001
PULSE_STORE_ACCESS_KEY=minioadmin
PULSE_STORE_SECRET_KEY=change-me-local-only
PULSE_STORE_REGION=us-east-1
PULSE_STORE_FS_ROOT=./.pulse-store-data
PULSE_STORE_USE_SSL=false
PULSE_STORE_HOT_DAYS=30
PULSE_STORE_WARM_DAYS=365
# pulse-store HTTP app (compose service pulse-store-api; backend forced to minio there)
PULSE_STORE_HTTP_HOST=0.0.0.0
PULSE_STORE_HTTP_PORT=3030
PULSE_STORE_HTTP_MAX_BYTES=26214400
# pulse-api evidence module (P0-T350): backend memory|fs|minio (unset → memory).
# Signed content URLs: HMAC secret + TTL. Unset secret → random per process.
PULSE_EVIDENCE_SIGNING_SECRET=change-me-local-only
PULSE_EVIDENCE_URL_TTL_SECONDS=300
PULSE_EVIDENCE_MAX_BYTES=5242880
# Browser origins for pulse-web live mode (comma-separated; empty = CORS off).
PULSE_API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Observability ---
PULSE_PROM_PORT=9090
PULSE_GRAFANA_PORT=3001

# Obs (P0-T404)
PULSE_PROM_PORT=9090
PULSE_GRAFANA_PORT=3001
PULSE_GRAFANA_ADMIN_USER=admin
PULSE_GRAFANA_ADMIN_PASSWORD=voltpulse

# Sense CUDA (P0-T405) — host Gate0 venv + weights (gitignored blobs)
GP_CUDA_VENV_HOST=./local-notes/models-experiments/_scratch/venv
GP_CUDA_DETECTORS=corrosion
GP_DEVICE_CUDA=0
GP_CUDA_HEALTH_PORT=8082
