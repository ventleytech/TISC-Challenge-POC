# VoltPulse — copy to .env and fill locally. Never commit real .env.
# Compose project: voltpulse (see infra/compose/docker-compose.yml)

# --- Bus / topics (vp.*) ---
PULSE_KAFKA_BOOTSTRAP=pulse-bus:9092
PULSE_KAFKA_PORT=9092
PULSE_DETECT_TOPIC=vp.detect.v1
PULSE_FINDINGS_TOPIC=vp.findings.v1
PULSE_ALERTS_TOPIC=vp.alerts.v1
PULSE_LABELS_TOPIC=vp.labels.v1
PULSE_MODELS_TOPIC=vp.models.v1

# --- Media gateway ---
PULSE_GATEWAY_RTSP_PORT=8554

# --- Data plane ---
PULSE_API_PORT=3000
PULSE_API_BASE_URL=http://pulse-api:3000
PULSE_WEB_PORT=5173
PULSE_NOTIFY_ADAPTER=log

# C10 auth stub (S5 Energy roles). Local placeholders only — rotate for shared envs.
# Format: key:role:utility_id;...  Empty utility_id only for platform_admin.
PULSE_AUTH_ENABLED=true
PULSE_AUTH_STUB_KEYS=dev-platform:platform_admin:;dev-utility:utility_admin:00000000-0000-4000-8000-000000000001;dev-supervisor:energy_supervisor:00000000-0000-4000-8000-000000000001;dev-operator:energy_operator:00000000-0000-4000-8000-000000000001;dev-viewer:viewer:00000000-0000-4000-8000-000000000001


PULSE_PG_USER=voltpulse
PULSE_PG_PASSWORD=change-me-local-only
PULSE_PG_DB=voltpulse
PULSE_PG_PORT=5432
PULSE_DATABASE_URL=postgres://voltpulse:change-me-local-only@pulse-postgres:5432/voltpulse

# --- Object store (pulse-store) ---
PULSE_STORE_ENDPOINT=http://pulse-store:9000
PULSE_STORE_BUCKET=voltpulse-evidence
PULSE_STORE_API_PORT=9000
PULSE_STORE_CONSOLE_PORT=9001
PULSE_STORE_ACCESS_KEY=minioadmin
PULSE_STORE_SECRET_KEY=change-me-local-only

# --- Observability ---
PULSE_PROM_PORT=9090
PULSE_GRAFANA_PORT=3001
