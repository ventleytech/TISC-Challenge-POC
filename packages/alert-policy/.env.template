# VoltPulse alert-policy — copy/overlay as needed (gitignored .env)
# Optional JSON path (defaults to package config/default-policy.json)
VP_ALERT_POLICY_PATH=

# Channel enable flags (true|false); adapters stay mock for Demo Day
VP_ALERT_CHANNEL_PUSH_ENABLED=true
VP_ALERT_CHANNEL_SMS_ENABLED=true
VP_ALERT_CHANNEL_EMAIL_ENABLED=false
VP_ALERT_CHANNEL_ADAPTER=mock

# Comma-separated default notify channels when alert omits channels
VP_ALERT_DEFAULT_CHANNELS=push,sms

# Severity → SLA duration (minutes)
VP_ALERT_SLA_CRITICAL_MIN=15
VP_ALERT_SLA_HIGH_MIN=60
VP_ALERT_SLA_MEDIUM_MIN=240
VP_ALERT_SLA_LOW_MIN=1440
VP_ALERT_SLA_INFO_MIN=10080
