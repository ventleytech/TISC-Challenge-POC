# grid-perception — copy values into shell or root .env. Never commit secrets.
# Weight paths are local Gate0 files under local-notes/ (gitignored blobs).

PULSE_DETECT_TOPIC=vp.detect.v1
PULSE_KAFKA_BOOTSTRAP=pulse-bus:9092

GP_DEVICE=0
GP_CONF=0.25
GP_IMGSZ=640
GP_SOURCE=

# Serve loop (container / compose): watch inbox, append vp.detect.v1 JSON lines to the file bus.
GP_INBOX_DIR=
GP_DETECT_FILE=
GP_DETECTORS=sag,thermal_hotspot
GP_POLL_MS=1000
GP_INGEST_SOURCE=upload

# Absolute or repo-relative paths to .pt weights
GP_WEIGHTS_CORROSION=
GP_WEIGHTS_CRACK=
GP_WEIGHTS_VEGETATION=

# sag / thermal_hotspot use packages/detector-fallbacks (no weights).
# Set 1 to emit one ≤0.01 conf plumbing row; default empty detections + reason.
GP_FALLBACK_SENTINEL=0

# Ultralytics venv (documentation / scripts)
GP_VENV=local-notes/models-experiments/_scratch/venv
