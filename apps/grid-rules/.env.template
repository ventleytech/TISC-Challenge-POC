# grid-rules — no secrets. Copy to .env locally if needed.
GRID_RULES_SERVICE_NAME=grid-rules
GRID_RULES_ALERT_MIN_SEVERITY=medium

# Prefer alert-policy overlays (see packages/alert-policy/.env.template)
# VP_ALERT_SLA_CRITICAL_MIN=15
# VP_ALERT_SLA_HIGH_MIN=60
# VP_ALERT_SLA_MEDIUM_MIN=240
# VP_ALERT_SLA_LOW_MIN=1440
# VP_ALERT_SLA_INFO_MIN=10080
# VP_ALERT_DEFAULT_CHANNELS=push,sms

VP_TOPIC_DETECT=vp.detect.v1
VP_TOPIC_FINDINGS=vp.findings.v1
VP_TOPIC_ALERTS=vp.alerts.v1
# Kafka producer (off by default; file/stdout bus unaffected). Host broker: localhost:9094 (compose PLAINTEXT_HOST).
# GRID_RULES_KAFKA_PRODUCER_ENABLED=true
# KAFKA_BROKERS=localhost:9094
# GRID_RULES_KAFKA_CLIENT_ID=grid-rules

# Loop (serve.ts). Unset inputs → /health only.
# GRID_RULES_DETECT_FILE=./data/bus/vp.detect.v1.jsonl
# GRID_RULES_OUT_DIR=./data/bus
# GRID_RULES_ASSETS_FILE=fixtures/assets.json
# GRID_RULES_POLL_MS=1000
# GRID_RULES_KAFKA_CONSUMER_ENABLED=true
# GRID_RULES_KAFKA_GROUP_ID=grid-rules
# GRID_RULES_KAFKA_FROM_BEGINNING=false

# pulse-api HTTP sink (off when base URL unset). Needs a write-role key (PULSE_AUTH_STUB_KEYS).
# GRID_RULES_API_BASE_URL=http://localhost:3000
# GRID_RULES_API_KEY=
# GRID_RULES_API_TIMEOUT_MS=5000
